# =============================================================================
# Cortix - copia este archivo como .env.local y rellena lo que necesites
# =============================================================================

# --- Basico ------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=Cortix
# Sin barra final. En Vercel pon aqui tu dominio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clave con la que se firman los tokens de la pagina puente.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# OBLIGATORIA en produccion. Si cambia, las sesiones abiertas se invalidan.
APP_SECRET=

# --- Base de datos (Supabase) -------------------------------------------------
# Si dejas estas dos vacias, la app guarda todo en .data/links.json, que sirve
# para probar en local pero NO funciona en Vercel (disco de solo lectura).
# La clave secreta es la de "Secret keys" en Settings > API Keys (empieza por
# sb_secret_). Vale igual la antigua service_role: usa SUPABASE_SERVICE_ROLE_KEY.
# NUNCA le pongas el prefijo NEXT_PUBLIC_: acabaria en el navegador.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Pagina puente ------------------------------------------------------------
# Segundos de espera de cada paso, separados por coma.
#   "8,8"  -> dos pasos (dos tandas de anuncios). Recomendado.
#   "10"   -> un solo paso de 10 segundos, menos agresivo.
#   "5,5,5"-> tres pasos, mas ingresos y mas abandono.
GATE_STEPS=8,8
GATE_TOKEN_TTL_MIN=30

# Enlaces que puede crear una misma IP por hora.
CREATE_RATE_LIMIT=30

# Dominios prohibidos como destino, separados por coma.
BLOCKED_HOSTS=

# Password del panel /admin. Vacio = panel desactivado.
ADMIN_PASSWORD=

# =============================================================================
# ANUNCIOS (Monetag u otra red)
# =============================================================================
# Pega el snippet COMPLETO que te da la red, tal cual, entre comillas dobles.
# Si el snippet lleva comillas dobles por dentro, usa comillas simples fuera.
#
# Formatos que pagan por IMPRESION (CPM) -> son los que te interesan:
#   Banner            -> slots gateTop / gateMiddle / gateBottom / gateSide
#   In-Page Push      -> NEXT_PUBLIC_AD_GLOBAL
#   Vignette Banner   -> NEXT_PUBLIC_AD_GLOBAL
#   Interstitial      -> NEXT_PUBLIC_AD_GLOBAL
#   MultiTag          -> NEXT_PUBLIC_AD_GLOBAL (mezcla varios y optimiza solo)
#
# Formato que paga por CLIC:
#   Direct Link       -> no se usa en este proyecto
# -----------------------------------------------------------------------------

# Banners dentro de la pagina puente
NEXT_PUBLIC_AD_GATE_TOP=
NEXT_PUBLIC_AD_GATE_MIDDLE=
NEXT_PUBLIC_AD_GATE_BOTTOM=
NEXT_PUBLIC_AD_GATE_SIDE=

# Banner de la portada
NEXT_PUBLIC_AD_HOME=

# Scripts que se colocan solos (In-Page Push / Vignette / Interstitial / MultiTag)
NEXT_PUBLIC_AD_GLOBAL=

# Popunder: el que mas paga y el mas invasivo. Apagado por defecto.
NEXT_PUBLIC_AD_POPUNDER=false
NEXT_PUBLIC_AD_POPUNDER_SNIPPET=

# Recuadros grises donde iran los anuncios mientras no los configures.
# Ponlo en false cuando ya tengas los snippets reales.
NEXT_PUBLIC_AD_PLACEHOLDERS=true

# Lineas de ads.txt que te da la red. Separa cada linea con \n literal.
# Ejemplo: ADS_TXT=monetag.com, 1234567, DIRECT\ngoogle.com, pub-000, RESELLER
ADS_TXT=
